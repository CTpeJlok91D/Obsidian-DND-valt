views:
  - type: cards
    name: Доспехи карты
    filters:
      and:
        - file.inFolder("Предметы/Особые")
    order:
      - file.name
      - Стоимость
    image: note.Изображение
    imageFit: ""
    imageAspectRatio: 1.45
  - type: table
    name: Таблица
    filters:
      and:
        - file.hasTag("Доспех")
    order:
      - file.name
      - Стоимость
      - КД
      - Скрытность
      - Изображение
