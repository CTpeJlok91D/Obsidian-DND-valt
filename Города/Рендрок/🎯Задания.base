views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("Задание")
        - file.hasLink("Страны/Палланор/Рендрок/🏢Рендрок")
    order:
      - file.name
      - Выполнено
      - Провелено
      - Выдаватель
      - Награда
      - Исполнитель
    sort:
      - property: Провелено
        direction: ASC
      - property: Выполнено
        direction: ASC
    markers: none
    indentProperties: false
    columnSize:
      note.Награда: 143
