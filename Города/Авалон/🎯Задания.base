views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasLink("Города/Авалон/🏢Авалон")
        - file.hasTag("Задание")
    order:
      - file.name
      - Выполнено
      - Провелено
      - Выдаватель
      - Награда
      - Исполнитель
    sort:
      - property: Провелено
        direction: ASC
      - property: Выполнено
        direction: ASC
    markers: none
    indentProperties: false
