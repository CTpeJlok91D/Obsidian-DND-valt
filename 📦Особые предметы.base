views:
  - type: cards
    name: Доспехи карты
    filters:
      and:
        - file.inFolder("📦Предметы")
        - '!file.inFolder("📦Предметы/Оружие")'
        - '!file.inFolder("📦Предметы/Доспехи")'
        - '!file.inFolder("📦Предметы/Свойста")'
        - '!file.inFolder("📦Предметы/Бомбы")'
    order:
      - file.name
      - Стоимость
    image: note.Изображение
    imageFit: ""
    imageAspectRatio: 1.5
  - type: table
    name: Таблица
    filters:
      and:
        - file.hasTag("Доспех")
    order:
      - file.name
      - Стоимость
      - КД
      - Скрытность
      - Изображение
